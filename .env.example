# ============================================================
# 首次使用：复制此文件为 .env 并填入配置
#   cp .env.example .env
# ============================================================

# LLM API 密钥（AI 助手 + 智能提取需要）
# 前往 https://open.bigmodel.cn/ 注册获取
GLM_API_KEY=

# 数据库配置（Docker 部署时默认使用 compose 内的 db 服务）
# 以下值用于 Docker Compose；本地直启后端时把 DB_HOST 改为 localhost
DB_HOST=db
DB_PORT=5432
DB_NAME=scau_archive
DB_USER=postgres
# 必须设置，使用新变量名避免与系统级 DB_PASS 冲突
DB_PASSWORD=

# Redis（Compose 内由服务名 redis 连接；宿主机本地开发默认 localhost:6379）
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# JWT 签名密钥（生产环境务必改为强密码，32位以上）
JWT_SECRET=8Z7x9sKpR2tG5bN3aQ6dF1cV4wH7jY0u

# LLM 配置（可选，有默认值）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4v-plus-0111
