# ============================================================
# 首次使用：复制此文件为 .env 并填入配置
#   cp .env.example .env
# ============================================================

# LLM API 密钥（AI 助手 + 智能提取需要）
# 前往 https://open.bigmodel.cn/ 注册获取
GLM_API_KEY=

# 数据库配置（Docker 部署时默认使用 compose 内的 db 服务）
DB_HOST=db（docker-compose 部署时无需修改）
DB_PORT=5432（docker-compose 部署时无需修改）
DB_NAME=scau_archive（docker-compose 部署时无需修改）
DB_USER=postgres（docker-compose 部署时无需修改）
# DB_PASS=你的强密码（必须设置，否则服务无法启动）

# JWT 签名密钥（生产环境务必改为强密码，32位以上）
JWT_SECRET=8Z7x9sKpR2tG5bN3aQ6dF1cV4wH7jY0u

# LLM 配置（可选，有默认值）
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4v-plus-0111
